model User {
  userId    String   @id @map("user_id") @db.VarChar(50)
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  status    String   @default("REGISTERED") @db.VarChar(20)
  activationTokenHash      String?  @map("activation_token_hash") @db.VarChar(64)
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at") @db.Timestamptz
  lastLoginAttemptAt DateTime? @map("last_login_attempt_at") @db.Timestamptz

  // Kolom Audit (Harus ditulis, tapi terisolasi di file ini saja)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.VarChar(50)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.VarChar(50)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?  @map("deleted_by") @db.VarChar(50)
  isDeleted Boolean  @default(false) @map("is_deleted")

  userGroups    UserGroup[]
  refreshTokens RefreshToken[]

  @@map("users")
}
